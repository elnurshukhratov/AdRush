generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Reklama ko'rish sessiyasi holati (server tomonida boshqariladi)
enum AdSessionStatus {
  PENDING   // server sessiya ochdi, reklama ko'rilmoqda
  CLAIMED   // klient "ko'rdim" dedi, AdsGram server tasdig'i (Reward URL) kutilmoqda
  REWARDED  // hisoblandi (+olmos)
  EXPIRED   // muddati o'tdi / yangi sessiya bilan almashtirildi
  REJECTED  // shubhali (masalan juda tez claim) — hisoblanmaydi
}

// Ledger valyutasi: RUSH = Rush Coin (User.rushCoins), DIAMOND = Olmos (User.diamonds), UZS = so'm (User.balanceUzs, butun so'm)
enum CoinCurrency {
  RUSH
  DIAMOND
  UZS
}

// Ledger harakati turi.
//  ADS_REWARD (+olmos), REFERRAL_REWARD (+olmos), SUBSCRIBE_REWARD (+Rush),
//  TRANSFER_OUT (-Rush) / TRANSFER_IN (+Rush) — foydalanuvchilar orasida o'tkazma (ikkala yozuv refType='TRANSFER' va bir xil refId bilan bog'langan),
//  CONVERT_OUT (-olmos) / CONVERT_IN (+Rush) — olmosni Rush Coin ga almashtirish (refType='CONVERT', bir xil refId),
//  SHOP_PURCHASE (-Rush) / SHOP_REFUND (+Rush) — do'kon,
//  WALLET_TOPUP (+so'm) — Telegram to'lovi orqali so'm balansni to'ldirish,
//  COIN_BUY_OUT (-so'm) / COIN_BUY_IN (+Rush) — so'm hisobidan Rush Coin sotib olish (refType='COIN_BUY', bir xil refId),
//  ADMIN_GRANT (+Rush) — admin paneldan qo'lda yuborilgan tanga (refType='ADMIN_GRANT', refId = yuborish UUID'si; kim yuborgani AuditLog da),
//  CHESS_WIN (+olmos) / CHESS_LOSS (-olmos) — shahmat va shashka o'yini natijasi (refType='CHESS' yoki 'CHECKERS', refId = ChessGame.id).
// COMPETITION_BET, LOSS_REFUND, COMPETITION_WIN — eski yozuvlar uchun saqlangan (bazada qoladi, ilova ko'rsatmaydi).
enum CoinTxType {
  ADS_REWARD
  REFERRAL_REWARD
  COMPETITION_BET
  LOSS_REFUND
  COMPETITION_WIN
  SUBSCRIBE_REWARD
  TRANSFER_OUT
  TRANSFER_IN
  CONVERT_OUT
  CONVERT_IN
  SHOP_PURCHASE
  SHOP_REFUND
  WALLET_TOPUP
  COIN_BUY_OUT
  COIN_BUY_IN
  ADMIN_GRANT
  CHESS_WIN
  CHESS_LOSS
}

// O'yin turi: CHESS = shahmat, CHECKERS = shashka (rus shashkasi). Eski yozuvlar avtomatik CHESS.
enum GameType {
  CHESS
  CHECKERS
}

// Shahmat: o'yin turi (BOT = kompyuterga qarshi, ONLINE = haqiqiy foydalanuvchi bilan)
enum ChessMode {
  BOT
  ONLINE
}

enum ChessStatus {
  ACTIVE
  FINISHED
}

// Natija oq tomondan: WHITE = oq yutdi, BLACK = qora yutdi, DRAW = durang
enum ChessResult {
  WHITE
  BLACK
  DRAW
}

// O'yin tugash sababi
enum ChessEnd {
  CHECKMATE
  STALEMATE
  DRAW_RULE // uch marta takrorlanish, 50 yurish qoidasi, material yetishmasligi, kelishilgan durang
  RESIGN
  TIMEOUT // onlayn soat tugadi
  ABANDON // bot o'yini harakatsiz qoldi
  NO_MOVES // shashka: raqibning donalari qolmadi yoki yura olmaydi
}

// Telegram to'lovi holati: PENDING (invoice yaratildi) -> PAID (successful_payment keldi) | FAILED | CANCELLED
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

// Do'kon mahsuloti turi: faqat belgi/kategoriya, mantiqni o'zgartirmaydi
enum ShopKind {
  GIFT
  STARS
  PREMIUM
  CUSTOM
}

// Do'kon buyurtmasi holati. DELIVERED / CANCELLED dan keyin o'zgarmaydi.
enum ShopOrderStatus {
  PENDING
  PROCESSING
  DELIVERED
  CANCELLED
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

model User {
  id         Int       @id @default(autoincrement())
  telegramId BigInt    @unique
  username   String?
  firstName  String?
  isBlocked  Boolean   @default(false)
  // Foydalanuvchi tili: 'uz' | 'en' | 'ru'. NULL — hali tanlamagan (botda birinchi /start da so'raladi)
  language   String?
  // Rush Coin balansi — faqat server o'zgartiradi (CoinTransaction ledger bilan birga, bitta tranzaksiyada)
  rushCoins  Int       @default(0)
  // Olmos balansi — faqat server o'zgartiradi (ledger bilan birga). Olmos reklama va referaldan olinadi, Rush Coin ga almashtiriladi.
  diamonds   Int       @default(0)
  // So'm balansi (butun so'm) — faqat server o'zgartiradi (ledger bilan birga). Faqat Telegram to'lovi bilan to'ladi, faqat Rush Coin sotib olishga sarflanadi.
  balanceUzs Int       @default(0)
  // Kim taklif qilgani (referral). Faqat bir marta, yangi user /start qilganda yoziladi.
  referredByUserId Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  rewards  AdReward[]
  sessions AdSession[]
  coinTxs  CoinTransaction[]
  shopOrders ShopOrder[]
  payments   Payment[]
  chessWhite ChessGame[] @relation("ChessWhite")
  chessBlack ChessGame[] @relation("ChessBlack")
  chessQueue ChessQueue? @relation("ChessQueueUser")

  referredBy User?  @relation("Referral", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referrals  User[] @relation("Referral")

  @@index([isBlocked])
  @@index([referredByUserId])
}

model AdReward {
  id               BigInt   @id @default(autoincrement())
  userId           Int
  // Unikal reward kaliti (duplicate/replay himoyasi). AdsGram rasmiy hujjatida reward/event ID
  // BERILMAYDI, shuning uchun bu yerda BIZ yaratgan AdSession.id saqlanadi.
  externalRewardId String   @unique
  createdAt        DateTime @default(now())
  metadata         Json?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  // cooldown (oxirgi reward) va kunlik limit (userId + createdAt oralig'i) so'rovlari uchun
  @@index([userId, createdAt(sort: Desc)])
}

// Server ochgan reklama sessiyasi: har bir reward faqat bitta sessiyaga bog'lanadi
model AdSession {
  id           String          @id @default(uuid()) @db.Uuid
  userId       Int
  status       AdSessionStatus @default(PENDING)
  slot         Int             @default(0) // ESKI maydon (5 ta AdsGram karta davridan qolgan). Endi ishlatilmaydi — provider + placement ishlatiladi
  // Reklama provayderi: 'adsgram' | 'monetag' | 'onclicka'. Har bir sessiya aynan bitta provayderga bog'langan.
  provider     String          @default("adsgram")
  // Reklama joyi: 'task' (Vazifalar kartasi) | 'quick' (tepada doim turadigan +1 olmos; faqat adsgram). Cooldown (provider, placement) bo'yicha alohida.
  placement    String          @default("task")
  createdAt    DateTime        @default(now())
  expiresAt    DateTime
  claimedAt    DateTime?
  rewardedAt   DateTime?
  rejectReason String?

  user         User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  confirmation AdsgramConfirmation?

  @@index([userId, status])
  @@index([status, expiresAt])
  @@index([userId, provider, placement, status])
}

// Server-to-server tasdiqlar: AdsGram Reward URL va OnClickA "confirm view" GET so'rovi.
// Ikkala provayder ham faqat telegramId yuboradi (reward ID / imzo yo'q), shuning uchun
// har bir tasdiq bitta sessiyaga ko'pi bilan bir marta bog'lanadi. provider/placement tasdiq qaysi
// provayder/joydan kelganini bildiradi — boshqa provayder sessiyasiga hech qachon bog'lanmaydi.
// (Monetag bu jadvalni ishlatmaydi: postback ymid = sessiya ID ni o'zi olib keladi.)
model AdsgramConfirmation {
  id         BigInt   @id @default(autoincrement())
  telegramId BigInt
  provider   String   @default("adsgram")
  placement  String   @default("task")
  receivedAt DateTime @default(now())
  sessionId  String?  @unique @db.Uuid

  session AdSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([telegramId, receivedAt])
  @@index([telegramId, provider, placement, receivedAt], map: "AdsgramConfirmation_tg_prov_plc_recv_idx")
}

// Reklama provayderlari sozlamalari (admin paneldan o'zgaradi). Faqat OMMAVIY identifikatorlar:
// AdsGram block ID, Monetag zone ID / SDK URL, OnClickA spot ID / SDK URL. MAXFIY tokenlar bu yerda emas — .env da.
// Qator yo'q = .env dagi standart qiymat; qator bor (bo'sh ham) = shu qiymat ishlatiladi.
model AdSetting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
  updatedBy BigInt?
}

// Ledger: har bir balans o'zgarishi shu yerda (amount: + kirim, - chiqim; currency: qaysi balans). Faqat qo'shiladi.
// idempotencyKey UNIQUE: bir hodisa (reklama sessiyasi, referral, almashtirish, xarid, refund) ikki marta yozilmaydi.
//   ADS_REWARD:<sessionId> | REFERRAL_REWARD:<yangiUserId> | CONVERT_OUT:<userId>:<requestId> | CONVERT_IN:<userId>:<requestId> | ...
model CoinTransaction {
  id             BigInt       @id @default(autoincrement())
  userId         Int
  amount         Int
  currency       CoinCurrency @default(RUSH)
  type           CoinTxType
  idempotencyKey String       @unique
  refType        String?
  refId          String?
  createdAt      DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, type])
}

// Telegram Bot Payments to'lovi (so'm balansni to'ldirish). id = invoice payload.
// telegramChargeId UNIQUE: bir to'lov hodisasi ikki marta hisoblanmaydi. amountUzs — butun so'm (Telegram'ga so'm*100 tiyinda yuboriladi).
model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  userId           Int
  amountUzs        Int
  status           PaymentStatus @default(PENDING)
  telegramChargeId String?       @unique
  providerChargeId String?
  createdAt        DateTime      @default(now())
  paidAt           DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
}

// Do'kon mahsuloti: hammasini admin qo'shadi (seed hech narsa qo'shmaydi). stock = null -> cheksiz.
model ShopProduct {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  // Faqat bizning /uploads/shop/... yo'li
  imageUrl    String?
  priceRush   Int
  kind        ShopKind @default(CUSTOM)
  stock       Int?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders ShopOrder[]

  @@index([isActive, sortOrder])
}

// Buyurtma: mahsulot snapshoti (nom, tur, narx) xarid paytida saqlanadi — mahsulot keyin o'zgarsa/o'chsa ham tarix qoladi.
model ShopOrder {
  id           Int             @id @default(autoincrement())
  userId       Int
  productId    Int?
  productTitle String
  productKind  ShopKind
  priceRush    Int
  status       ShopOrderStatus @default(PENDING)
  adminNote    String?
  proofImage   String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  resolvedAt   DateTime?
  // Ommaviy "Tarix" bo'limida ko'rinish vaqti. Faqat status=DELIVERED VA proofImage bor bo'lganda, bir marta (birinchi shart bajarilgan payt) yoziladi.
  // NULL = Tarixda ko'rinmaydi (bekor qilingan / topshirilmagan / isbot rasmi yo'q). Bir buyurtma = bir qator, shuning uchun Tarixda takror bo'lmaydi.
  confirmedAt  DateTime?

  user    User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  product ShopProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId, id(sort: Desc)])
  @@index([status, id(sort: Desc)])
  @@index([productId])
  @@index([confirmedAt(sort: Desc), id(sort: Desc)])
}

model Admin {
  id         Int       @id @default(autoincrement())
  telegramId BigInt    @unique
  username   String?
  role       AdminRole @default(ADMIN)
  createdAt  DateTime  @default(now())
}

// Audit + shubhali activity jurnali (faqat qo'shiladi, o'chirilmaydi).
// action: ADMIN_*, USER_BLOCKED, COIN_TRANSFER, SUSPICIOUS:<TYPE> ...
model AuditLog {
  id              BigInt   @id @default(autoincrement())
  actorTelegramId BigInt?
  action          String
  entityType      String?
  entityId        String?
  details         Json?
  createdAt       DateTime @default(now())

  @@index([action, createdAt])
  @@index([actorTelegramId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt(sort: Desc)])
}

// Majburiy obuna kanali (admin paneldan qo'shiladi). Bir vaqtda faqat bitta isActive=true.
// chatId — Telegram chat id (-100...), getChatMember shu bilan chaqiriladi.
model RequiredChannel {
  id        Int      @id @default(autoincrement())
  chatId    BigInt
  username  String?
  title     String
  inviteUrl String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// Shahmat o'yini. Bot o'yinida bitta tomon (whiteUserId yoki blackUserId) NULL va botLevel (1..3) to'ldiriladi.
// moves — SAN yurishlar ro'yxati (JSON massiv). Soat maydonlari faqat onlayn o'yinda ishlatiladi (bot o'yinida NULL).
// whiteDelta / blackDelta — shu o'yin uchun berilgan (+) yoki ayirilgan (-) olmos; settleGame yozadi.
// settledAt — hisob-kitob bajarilgan vaqt (NULL bo'lsa hali hisoblanmagan; ikkinchi marta hisoblanmaydi).
model ChessGame {
  id           String      @id @default(uuid()) @db.Uuid
  gameType     GameType    @default(CHESS)
  mode         ChessMode
  status       ChessStatus @default(ACTIVE)
  whiteUserId  Int?
  blackUserId  Int?
  botLevel     Int?
  fen          String
  moves        Json        @default("[]")
  moveCount    Int         @default(0)
  lastMoveAt   DateTime    @default(now())
  whiteTimeMs  Int?
  blackTimeMs  Int?
  incrementMs  Int         @default(0)
  result       ChessResult?
  endReason    ChessEnd?
  whiteDelta   Int         @default(0)
  blackDelta   Int         @default(0)
  rewardGranted Boolean    @default(false)
  settledAt    DateTime?
  createdAt    DateTime    @default(now())

  white User? @relation("ChessWhite", fields: [whiteUserId], references: [id], onDelete: Restrict)
  black User? @relation("ChessBlack", fields: [blackUserId], references: [id], onDelete: Restrict)

  // foydalanuvchining faol o'yini (white/black bo'yicha alohida)
  @@index([whiteUserId, status])
  @@index([blackUserId, status])
  // maintenance: harakatsiz / vaqti tugagan faol o'yinlar
  @@index([status, mode, lastMoveAt])
  // kunlik bot limiti va juftlik limiti hisobi
  @@index([whiteUserId, settledAt])
  @@index([blackUserId, settledAt])
}

// Onlayn o'yin navbati. Foydalanuvchi bitta (unique). lastSeenAt har holat so'rovida yangilanadi, eskirgan yozuvlar e'tiborga olinmaydi.
model ChessQueue {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  gameType   GameType @default(CHESS)
  joinedAt   DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation("ChessQueueUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([joinedAt])
  @@index([lastSeenAt])
  @@index([gameType, joinedAt])
}