{
  "name": "kolizey-mine-bot",
  "version": "1.0.0",
  "description": "KOLIZEY MINE - oylik AdsGram reklama chempionati (bot + backend)",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "node prisma/seed.js",
    "db:setup": "prisma generate && prisma migrate deploy && node prisma/seed.js",
    "check": "find src prisma tests -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test": "node --test tests/*.test.js",
    "docker:up": "docker compose up -d --build",
    "docker:logs": "docker compose logs -f app"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "chess.js": "^1.4.0",
    "compression": "^1.8.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "grammy": "^1.30.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "pino": "^9.4.0",
    "pino-http": "^10.5.0",
    "prisma": "^5.22.0",
    "rate-limit-redis": "^4.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "pino-pretty": "^11.3.0"
  }
}
