# --- Umumiy ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Reverse proxy (nginx, Cloudflare, Railway...) ortida bo'lsa proxy soni (odatda 1). Aks holda 0.
# To'g'ri qo'yilmasa rate limit noto'g'ri IP bo'yicha ishlaydi.
TRUST_PROXY=0

# HTTP so'rov timeouti va graceful shutdown kutish vaqti (soniya)
HTTP_REQUEST_TIMEOUT_SEC=30
SHUTDOWN_TIMEOUT_SEC=15

# --- Telegram ---
# @BotFather dan olingan token (HECH QACHON GitHubga yuklamang)
BOT_TOKEN=7978982368:AAHXBgDDpl7KnjSdWN2I8eq3N_hVEW0z63g
# Admin Telegram ID lari, vergul bilan: 123456789,987654321
ADMIN_IDS=8170249227
# Mine App (Telegram Web App) URL — MAJBURIY, https://. Botdagi "ILOVANI OCHISH" tugmasi shu yerga ochadi
MINE_APP_URL=https://refer-red-return-riverside.trycloudflare.com/mine/
# Mini App initData qancha vaqt (soniya) amal qiladi. Default 86400 (24 soat)
TELEGRAM_INITDATA_MAX_AGE_SEC=86400

# Bot rejimi:
#   polling (default) — long polling. FAQAT BITTA instansiyada ishlaydi (ikkinchisi 409 Conflict beradi).
#   webhook — Telegram update'larni HTTPS orqali yuboradi (bir nechta instansiya mumkin).
BOT_MODE=polling
# BOT_MODE=webhook bo'lsa majburiy:
#   WEBHOOK_URL    — ommaviy HTTPS manzil, oxirida "/" siz (masalan https://bot.example.com)
#   WEBHOOK_SECRET — Telegram secret_token: 16-256 belgi, faqat A-Z a-z 0-9 _ -   (openssl rand -hex 32)
WEBHOOK_URL=
WEBHOOK_SECRET=

# --- Database ---
DATABASE_URL=postgresql://kolizey:0700@localhost:5432/kolizey_mine?schema=public

# --- Redis (ixtiyoriy) ---
# Bo'sh = rate limit xotirada (bitta instansiya uchun yetarli).
# To'ldirilsa API rate limitlari instansiyalar orasida umumiy bo'ladi. Redis ishlamasa API yiqilmaydi (fail-open).
# Masalan: redis://localhost:6379
REDIS_URL=

# --- AdsGram ---
# Standart (fallback) qiymatlar: admin paneldan (📺 Reklama) o'zgartirilmagan bo'lsa ishlatiladi.
# Vazifalardagi AdsGram kartasi uchun Reward block ID (raqam, masalan 12345).
ADSGRAM_BLOCK_ID=
# Tepadagi doim ko'rinadigan "+1 olmos" tugmasi uchun ALOHIDA Reward block ID. Vazifalar blokidan FARQLI bo'lishi shart;
# bo'sh qoldirilsa yoki bir xil bo'lsa tepadagi tugma o'chiq turadi (asosiy blokka almashtirilmaydi).
ADSGRAM_QUICK_BLOCK_ID=
# Reward hisoblash rejimi:
#   server_confirmed (tavsiya, default) — +1 faqat AdsGram Reward URL (server-to-server) tasdiqlagandan keyin
#   client_session — AdsGram server tasdig'isiz, faqat bizning sessiya/vaqt/limit tekshiruvlari (zaifroq!)
ADSGRAM_VERIFY_MODE=server_confirmed
# Reward URL himoyasi uchun O'ZIMIZ yaratgan maxfiy token (AdsGram imzo bermaydi!).
# Yaratish: openssl rand -hex 32   (faqat A-Z a-z 0-9 _ - ; kamida 24 belgi)
# AdsGram kabinetida Reward URL:
#   Vazifalar bloki: https://YOUR_DOMAIN/api/adsgram/reward?userid=[userId]&placement=task&token=<SHU_TOKEN>
#   Tepadagi +1 bloki: https://YOUR_DOMAIN/api/adsgram/reward?userid=[userId]&placement=quick&token=<SHU_TOKEN>
ADSGRAM_REWARD_TOKEN=eedd8a6fe6a881fb4f9dbab090eeaf0a96d32dea6f559fce0f7571dd14246755
# Ixtiyoriy: Reward URL ga ruxsat etilgan IP lar (vergul bilan). Bo'sh = tekshirilmaydi.
# AdsGram rasmiy IP ro'yxatini bermagan — faqat support tasdiqlasa to'ldiring.
ADSGRAM_CALLBACK_IP_ALLOWLIST=

# --- Monetag (Telegram Mini App SDK) ---
# Postback URL Monetag SSP da asosiy SDK zonasi sozlamalarida kiritiladi (Monetag imzo bermaydi — shuning uchun O'ZIMIZ token qo'yamiz):
#   https://YOUR_DOMAIN/api/monetag/postback?ymid={ymid}&zone_id={zone_id}&event_type={event_type}&reward_event_type={reward_event_type}&telegram_id={telegram_id}&token=<SHU_TOKEN>
# Zone ID va SDK manzili admin paneldan (📺 Reklama) kiritiladi. Token yo'q bo'lsa Monetag kartasi o'chiq turadi.
# Token: kamida 24 belgi (A-Z a-z 0-9 _ -), boshqa tokenlardan FARQLI. Yaratish: openssl rand -hex 32
MONETAG_POSTBACK_TOKEN=5e571e75222c8cc4e68525e677fc8eae7d49d1599bc50f71d0553f1a007ad59e

# --- OnClickA (TMA video) ---
# Ko'rish tasdig'i handler URL: OnClickA ?USERID=<telegramId> ni URL oxiriga o'zi qo'shadi, shuning uchun token URL YO'LIDA:
#   https://YOUR_DOMAIN/api/onclicka/reward/<SHU_TOKEN>
# SPOT-ID va SDK manzili admin paneldan kiritiladi. Token yo'q bo'lsa OnClickA kartasi o'chiq turadi.
# Token: kamida 24 belgi, boshqa tokenlardan FARQLI. Yaratish: openssl rand -hex 32
ONCLICKA_CALLBACK_TOKEN=ff950f3735c7bc1b3b476da8e49e244b1645443c798d4e50cda4586919a33530

# --- Reklama sessiyasi / anti-abuse ---
# Sessiya amal qilish muddati (soniya)
AD_SESSION_TTL_SEC=600
# Sessiya ochilgandan keyin claim qilish mumkin bo'lgan eng kam vaqt (millisekund)
AD_MIN_DURATION_MS=8000
# Bir userning ketma-ket ikki reward orasidagi eng kam vaqt (millisekund)
AD_COOLDOWN_MS=5000
# Bir userning kunlik (UTC) maksimal reward soni. 0 = cheklov yo'q
AD_DAILY_CAP=0

# --- Leaderboard / Mine App API (3-bosqich) ---
# Default va maksimal TOP soni (GET /api/leaderboard/current?limit=)
LEADERBOARD_DEFAULT_LIMIT=10
LEADERBOARD_MAX_LIMIT=100
# TOP ro'yxatining server keshi (ms). Polling yukini kamaytiradi. 0 = o'chiq
LEADERBOARD_CACHE_TTL_MS=5000
# Mine App ga "qancha soniyada yangila" tavsiyasi
LEADERBOARD_REFRESH_SEC=15
# false bo'lsa API javobida telegramId qaytarilmaydi (faqat username/firstName)
LEADERBOARD_EXPOSE_TELEGRAM_ID=true

# --- Competition auto-end / bot himoyasi ---
# Vaqti tugagan faol competition ni tekshirish davri (soniya). Tugagan competition avtomatik ENDED bo'ladi, g'oliblar sovrin place bo'yicha aniqlanadi
ROLLOVER_CHECK_SEC=60
# Bitta user botga oynada yuborishi mumkin bo'lgan maksimal update soni / oyna (soniya)
BOT_THROTTLE_MAX=15
BOT_THROTTLE_WINDOW_SEC=10

# --- Sovrin rasmlari (admin Mine App ichidan yuklaydi) ---
# Rasmlar saqlanadigan papka (Docker'da /app/uploads — volume). Bo'sh = ./uploads
UPLOAD_DIR=
# Bitta rasmning maksimal hajmi (bayt). Default 2 MB (klient rasmni oldindan kichraytiradi)
UPLOAD_MAX_BYTES=2097152

# --- Docker Compose (faqat docker-compose.yml uchun) ---
# Quyidagi qiymatlar docker-compose da PostgreSQL va portlarni sozlaydi. Parol: faqat harf/raqam tavsiya etiladi.
POSTGRES_USER=kolizey
POSTGRES_PASSWORD=01aed64dfcee9b56586cac51b438c089e6633d428af5a3e5
POSTGRES_DB=kolizey_mine
# App porti serverda qaysi interfeysga bog'lanadi (reverse proxy uchun 127.0.0.1 qoldiring)
APP_BIND=127.0.0.1
APP_PORT=3000
# Konteyner ishga tushganda migratsiya va (idempotent) seed ni avtomatik bajarish
RUN_MIGRATIONS=true
RUN_SEED=true

# --- Rush Coin (ichki valyuta) ---
# 1 ta valid reklama = +N Rush Coin
RUSH_AD_REWARD=5
# Yangi taklif qilingan user uchun taklif qiluvchiga beriladigan Rush Coin
RUSH_REFERRAL_REWARD=20
# Majburiy kanalga obuna bo'lgani uchun bir martalik mukofot (Rush Coin)
RUSH_SUBSCRIBE_REWARD=50
# Bitta user kuniga (UTC) olishi mumkin bo'lgan referallar soni (0 = cheklovsiz)
RUSH_REFERRAL_DAILY_CAP=100
# Yutqazgan tikishning qaytariladigan foizi (0..100)
RUSH_LOSS_REFUND_PERCENT=30
# Bir vaqtda faol tikishlar soni (bitta user uchun)
MAX_ACTIVE_BETS=5
# Bitta tikishning minimal/maksimal miqdori
RUSH_MIN_BET=1
RUSH_MAX_BET=1000000
# Referal havola uchun bot username (@siz). Bo'sh bo'lsa Telegram getMe orqali aniqlanadi
BOT_USERNAME=

# --- So'm hamyon (Telegram Bot Payments) — faqat Profil bo'limi ---
# Payments provayder tokeni (@BotFather -> /mybots -> Bot Settings -> Payments). Bo'sh = hamyon o'chiq.
# Quyidagi qiymat SOXTA namuna — haqiqiy tokenni faqat .env ga yozing.
PAYMENT_PROVIDER_TOKEN=371317599:TEST:1791794143556
# 1 Rush Coin narxi (so'm). 10 => 500 tanga = 5 000 so'm
COIN_PRICE_UZS=10
# So'm balansni to'ldirishning eng kam miqdori (so'm)
TOPUP_MIN_UZS=5000
# Texnik yuqori chegara (so'm) — faqat Int/Telegram limitidan oshmaslik uchun, biznes limit emas
TOPUP_MAX_UZS=100000
# Bir martada sotib olinadigan eng kam Rush Coin
COIN_BUY_MIN=500
# Tayyor paketlar (Rush Coin miqdori, vergul bilan)
COIN_PACKAGES=500,1000,2500,5000,10000

# --- Shahmat (Home) ---
# Yutuq uchun beriladigan olmos
CHESS_WIN_DIAMONDS=3
# Mag'lubiyat uchun ayiriladigan olmos (balans yetmasa yetganicha, 0 dan pastga tushmaydi)
CHESS_LOSS_DIAMONDS=1
# Olmos hisoblanishi uchun foydalanuvchining kamida nechta yurishi bo'lishi kerak
CHESS_MIN_USER_MOVES=6
# Bot o'yinida kuniga (UTC) olmos beriladigan yutuqlar soni (0 = cheklovsiz); undan keyingi yutuq 0 olmos
CHESS_BOT_DAILY_WIN_LIMIT=10
# Bitta raqib bilan 24 soat ichida olmos beriladigan onlayn o'yinlar soni (0 = cheklovsiz); undan keyin olmos berilmaydi va ayirilmaydi
CHESS_PAIR_DAILY_LIMIT=3
# Bot o'yini shuncha daqiqa harakatsiz tursa foydalanuvchi yutqazgan hisoblanadi
CHESS_BOT_IDLE_MINUTES=30
# Onlayn o'yinda har tomonning umumiy vaqti (soniya)
CHESS_ONLINE_TIME_SECONDS=300
# Onlayn o'yinda har yurishdan keyin qo'shiladigan vaqt (soniya)
CHESS_ONLINE_INCREMENT_SECONDS=0
# Onlayn navbatda shuncha soniya "ko'rinmagan" yozuv eskirgan hisoblanadi
CHESS_QUEUE_STALE_SECONDS=45